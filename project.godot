config_version=5

[application]

config/name="Pew Pew Bubblegum"
run/main_scene="uid://c4lo3tmmigpnv"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://dd4fx4r4jkfuq"

[autoload]

GameManager="*uid://gp23kl8ubi02"
StringConstants="*uid://c9f2k3m8p7q1"
MusicPlayer="*uid://dm5qp2v6j4x15"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://resources/": "orange",
"res://scenes/": "red",
"res://scripts/": "green",
"res://shaders/": "pink"
}

